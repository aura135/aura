# AURA AI Personal Assistant Backend Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@localhost:5432/aura_db
# If left commented or unset, the backend runs seamlessly using the built-in persistent local store.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/aura_db

# Security & JSON Web Tokens
JWT_SECRET=aura_super_secure_jwt_secret_production_key_2026
JWT_EXPIRES_IN=30d

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGIN=*
